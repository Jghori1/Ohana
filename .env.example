# Required: main pet data source.
TINYFISH_API_KEY=
# Optional: maximum sites to search (default 6).
MAX_SITES=6
# Optional: backup pet source.
RESCUEGROUPS_API_KEY=
# Optional: chatbot key; the chatbot falls back to rules without it.
GEMINI_API_KEY=
# copy the current model name from Google AI Studio; leave empty to use the rule-based chatbot
GEMINI_MODEL=
# Optional: protects the refresh endpoint.
ADMIN_TOKEN=
# Optional: development/test default ZIP.
DEFAULT_ZIP=
# Optional: development/test latitude; visitor location is used in real sessions.
HOME_LAT=
# Optional: development/test longitude; visitor location is used in real sessions.
HOME_LNG=
# Optional: new ZIP codes allowed to start a TinyFish search per day (default 5).
AREA_LIMIT_PER_DAY=5
# Optional: backend port (default 8000).
PORT=8000
